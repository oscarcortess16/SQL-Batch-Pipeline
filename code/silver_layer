CREATE OR REFRESH STREAMING TABLE silver_sales_transactions (
  CONSTRAINT valid_order_id EXPECT (order_id IS NOT NULL) ON VIOLATION DROP ROW,
  CONSTRAINT valid_quantity EXPECT (quantity_ordered > 0) ON VIOLATION DROP ROW,
  CONSTRAINT valid_price    EXPECT (unit_price > 0) ON VIOLATION DROP ROW,
  CONSTRAINT valid_date     EXPECT (order_timestamp IS NOT NULL) ON VIOLATION DROP ROW
)
TBLPROPERTIES ("quality" = "silver")
AS
SELECT
  CAST(TRIM(raw_order_id) AS BIGINT)                          AS order_id,
  TRIM(raw_product)                                           AS product_name,
  CAST(TRIM(raw_quantity_ordered) AS INT)                     AS quantity_ordered,
  CAST(TRIM(raw_price_each) AS DECIMAL(10, 2))                AS unit_price,
  CAST(
    CAST(TRIM(raw_quantity_ordered) AS INT) * 
    CAST(TRIM(raw_price_each) AS DECIMAL(10, 2)) 
    AS DECIMAL(12, 2)
  )                                                           AS total_amount,
  to_timestamp(TRIM(raw_order_date), 'MM/dd/yy HH:mm')        AS order_timestamp,
  DATE(to_timestamp(TRIM(raw_order_date), 'MM/dd/yy HH:mm'))  AS order_date,
  HOUR(to_timestamp(TRIM(raw_order_date), 'MM/dd/yy HH:mm'))  AS order_hour,
  TRIM(SPLIT(raw_purchase_address, ',')[0])                   AS street_address,
  TRIM(SPLIT(raw_purchase_address, ',')[1])                   AS city,
  SPLIT(TRIM(SPLIT(raw_purchase_address, ',')[2]), ' ')[0]    AS state_code,
  SPLIT(TRIM(SPLIT(raw_purchase_address, ',')[2]), ' ')[1]    AS zip_code,
  source_file_name,
  ingestion_timestamp,
  current_timestamp()                                         AS silver_processed_timestamp
FROM STREAM(LIVE.bronze_sales_transactions)
WHERE raw_order_id IS NOT NULL
  AND TRIM(raw_order_id) <> 'Order ID';
